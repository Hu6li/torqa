<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth LE for the trainer, sensors and shifter: Android 12 and newer ask for scanning
         and connecting, older ones for location to scan. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Group voice opens capture only after explicit microphone enable and runtime consent. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Course videos a sync app put in ORQWA's shared folder (R149): Android 16 lets an app
         read only the videos it wrote there itself unless it may read videos. Asked for only
         when such a video cannot be opened. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Updates (R99): ORQWA installs the newer APK over itself, from Android 12 without asking
         each time; the rider allows installing apps once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.OrqwaAndroid"
            android:value="org.orqwa.android.OrqwaAndroid" />
    </application>
</manifest>
