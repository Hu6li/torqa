<workout_file>
    <author>Torqa</author>
    <name>Sweet spot 3 × 10</name>
    <description>Three 10-minute blocks at 90 % of FTP with 5 minutes easy in between: hard enough to build threshold, easy enough to recover from.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
        <SteadyState Duration="600" Power="0.90">
            <textevent timeoffset="0" message="First block: steady, not heroic."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="600" Power="0.90">
            <textevent timeoffset="0" message="Second block."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="600" Power="0.90">
            <textevent timeoffset="0" message="Last one."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
