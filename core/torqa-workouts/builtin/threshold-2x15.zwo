<workout_file>
    <author>Torqa</author>
    <name>Threshold 2 × 15</name>
    <description>Two 15-minute efforts just under FTP after a warm-up with short openers.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.45" PowerHigh="0.70"/>
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="60" OnPower="1.05" OffPower="0.55" Cadence="100" CadenceResting="85">
            <textevent timeoffset="0" message="Openers: three short pushes."/>
        </IntervalsT>
        <SteadyState Duration="120" Power="0.55"/>
        <SteadyState Duration="900" Power="0.97">
            <textevent timeoffset="0" message="Fifteen minutes just under threshold."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="900" Power="0.97">
            <textevent timeoffset="0" message="Second effort: same again."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
